  "requirements": [
    {
      "id": "10C-R01",
      "text": "完成名称、块环境、参数和定义先于使用/调用绑定",
      "spec": ["阶段10C", "阶段9"],
      "artifact": "已解析符号引用与块签名",
      "positiveCases": ["定义赋值后使用", "定义后块调用"],
      "negativeCases": ["先使用", "先调用", "跨块环境", "参数重复"],
      "forbiddenSubstitutes": ["运行时再按名称搜索", "块共享外层局部变量"]
    },
    {
      "id": "10C-R02",
      "text": "@ 重载绑定保存唯一 Descriptor、参数和返回契约",
      "spec": ["阶段10C", "PEVT7001-7010"],
      "artifact": "BoundCallExpression",
      "positiveCases": ["数量和完整类型唯一匹配"],
      "negativeCases": ["未知调用", "数量错误", "类型错误", "返回接收错误"],
      "forbiddenSubstitutes": ["运行时重新重载解析", "只返回 PevtType"]
    },
    {
      "id": "10C-R03",
      "text": "提供可扩展参数域接口但不提前依赖人物目录",
      "spec": ["阶段10C", "阶段12/13具体域"],
      "artifact": "IParameterDomain",
      "positiveCases": ["测试域接受已知值"],
      "negativeCases": ["测试域拒绝未知值"],
      "forbiddenSubstitutes": ["缺少接口留到阶段13", "在 Binder 写死人物 ID"]
    },
    {
      "id": "10C-R04",
      "text": "完成 handler、async 调用和 await all/any 静态绑定",
      "spec": ["阶段10C", "PEVT7201-7225"],
      "artifact": "已解析句柄符号、返回类型和集合等待绑定",
      "positiveCases": ["单句柄", "all", "any", "全写或全省略返回绑定"],
      "negativeCases": ["PEVT7203", "重复句柄", "数量不匹配", "无返回绑定", "嵌套绑定"],
      "forbiddenSubstitutes": ["Binder default 返回 Error 后忽略", "异步调用按同步返回值绑定"]
    },
    {
      "id": "10C-R05",
      "text": "exec 参数静态为 string，callevt 不查询真实事件 ID",
      "spec": ["阶段10C", "PEVT7403", "跨模组 callevt"],
      "artifact": "BoundExec 与 BoundCallEvent",
      "positiveCases": ["string exec", "未知 callevt 静态通过"],
      "negativeCases": ["非 string exec", "callevt 外围签名错误"],
      "forbiddenSubstitutes": ["编译期扫描 /event", "把 PEVT7403 推到运行时"]
    },
    {
      "id": "10C-R06",
      "text": "raw cs 完成能力、参数副本和源码保存，C# 语义唯一延期到阶段39",
      "spec": ["阶段10C", "PEVT8007-8015 owner=39"],
      "artifact": "BoundRawCSharp 节点",
      "positiveCases": ["enable cs 与合法参数副本"],
      "negativeCases": ["缺能力", "未定义或重复参数"],
      "forbiddenSubstitutes": ["10C 伪造 C# 编译结果", "阶段39复制 PEVT parser"]
    },
    {
      "id": "10C-R07",
      "text": "调用绑定结果深不可变且不保留可变 Descriptor/参数集合别名",
      "spec": ["阶段10C", "G5"],
      "artifact": "不可变调用绑定",
      "positiveCases": ["稳定枚举选中签名"],
      "negativeCases": ["修改输入签名表、参数列表和域集合"],
      "forbiddenSubstitutes": ["IReadOnlyList 包装可变 List"]
    }
  ],
