<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Polaris.IntegrationTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本项目验证 PEVT 宿主程序集边界；同仓库引用 Event 根项目，运行时依赖来自聚合仓库的同级 submodule。 -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\PolarisEvent.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\PolarisCore\PolarisCore.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\PolarisDiagnostics\PolarisDiagnostics.csproj" />
  </ItemGroup>

</Project>
