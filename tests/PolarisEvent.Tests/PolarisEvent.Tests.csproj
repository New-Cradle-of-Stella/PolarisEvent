<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Polaris.Event.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      固定引用 netstandard2.0 前端。net8.0 本来会优先挑 netstandard2.1，那份是游戏侧目标，
      会把 BepInEx / MonoMod / Unity 一起拖进测试宿主，而这些程序集在测试环境里并不存在——
      表现是 xUnit 在加载部分测试类时报 "Catastrophic failure" 并静默少跑一批用例。
      本项目按计划就是"无游戏依赖"的语言与人物目录测试，锁在前端目标上也更贴合它的职责。
    -->
    <ProjectReference Include="..\..\PolarisEvent.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
