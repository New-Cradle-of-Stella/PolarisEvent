<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>PolarisEvent</AssemblyName>
    <RootNamespace>Polaris.Event</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!--
      Roslyn 是 NuGet 依赖而非项目引用，类库默认不会把它拷进输出目录，deploy-polaris.ps1
      只从输出目录取 *.dll，于是 libs\ 里缺 Microsoft.CodeAnalysis*.dll：
      PevtRoslynRawCsCompiler 的字段类型解析不出来，组件发现整轮抛 TypeLoadException。
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    netstandard2.0 是供 PolarisTools 使用的纯 PEVT 前端：不引用 PolarisCore、PolarisRes、
    游戏程序集或 Unity，因此 VS 扩展不需要装游戏也能编译。
    netstandard2.1 是游戏侧组件目标，额外引用 PolarisCore 与 PolarisRes——游戏原子服务适配器
    和原版 PXLS 借用桥都在这个目标里。
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\PolarisCore\PolarisCore.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\PolarisRes\PolarisRes.csproj" />
  </ItemGroup>

  <!-- 只有游戏侧目标编译 Game/ 与组件入口；前端目标看不到它们，也就不可能意外引入游戏依赖。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="PolarisEventComponent.cs" />
    <Compile Remove="Game\**\*.cs" />
    <Compile Remove="Patch\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\**\*" />
  </ItemGroup>

  <!--
    `$raw cs` 需要一个真正的 C# 编译器：PEVT8007-8010 是"这段 C# 合不合法、返回什么类型、是不是
    每条路径都返回值"，没有语义分析就无法判定。默认实现是共享的 PevtRoslynRawCsCompiler，两个目标
    都编译它，这样工具侧与游戏侧对同一段 `$raw cs` 得到完全一致的 PEVTxxxx。

    宿主已经自带 Roslyn 时（例如 PolarisTools 的 VSIX 用 Visual Studio 自己那一份）可以设
    `-p:PevtRawCsCompiler=External` 换成外部实现：Core 侧的端口 IPevtRawCsCompiler /
    IPevtRawCsAnalyzer 保持不变，只是这个默认实现和它的包引用一起被移出编译。
  -->
  <PropertyGroup>
    <PevtRawCsCompiler Condition="'$(PevtRawCsCompiler)' == ''">Roslyn</PevtRawCsCompiler>
  </PropertyGroup>

  <ItemGroup Condition="'$(PevtRawCsCompiler)' == 'Roslyn'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(PevtRawCsCompiler)' != 'Roslyn'">
    <Compile Remove="Runtime\Raw\PevtRoslynRawCsCompiler.cs" />
  </ItemGroup>

  <!-- 游戏程序集引用只对 netstandard2.1 生效；条件写在 props 内部的 ItemGroup 上。 -->
  <Import Project="build\Polaris.Runtime.props" />
</Project>
